{
  "name": "cflow-web",
  "private": true,
  "version": "0.1.0",
  "description": "cFlow Studio and Portal: web front end for building, running and publishing governed data pipelines.",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "test": "npm run test:prefixo && npm run test:camadas && npm run test:ingestao && npm run test:tipos-conexao && npm run test:layout && npm run test:cadeias && npm run test:definicao && npm run test:carimbo && npm run test:promocao && npm run test:mapa-corrida && npm run test:poll && npm run test:pagina-carga && npm run test:listas-resumo && npm run test:login",
    "test:layout": "node scripts/teste-layout.mjs",
    "test:camadas": "node scripts/teste-camadas.mjs",
    "test:tipos-conexao": "node --import ./scripts/resolver-ts.mjs scripts/teste-tipos-conexao.mjs",
    "test:ingestao": "node --import ./scripts/resolver-ts.mjs scripts/teste-ingestao.mjs",
    "test:cadeias": "node --import ./scripts/resolver-ts.mjs scripts/teste-cadeias.mjs",
    "test:definicao": "node --import ./scripts/resolver-ts.mjs scripts/teste-definicao.mjs",
    "test:carimbo": "node --import ./scripts/resolver-ts.mjs scripts/teste-carimbo.mjs",
    "test:promocao": "node --import ./scripts/resolver-ts.mjs scripts/teste-promocao.mjs",
    "test:mapa-corrida": "node --import ./scripts/resolver-ts.mjs scripts/teste-mapa-corrida.mjs",
    "test:poll": "node --import ./scripts/resolver-ts.mjs scripts/teste-poll.mjs",
    "test:pagina-carga": "node --import ./scripts/resolver-ts.mjs scripts/teste-pagina-carga.mjs",
    "test:listas-resumo": "node --import ./scripts/resolver-ts.mjs scripts/teste-listas-resumo.mjs",
    "test:prefixo": "node scripts/teste-prefixo.mjs",
    "test:login": "node --import ./scripts/resolver-ts.mjs scripts/teste-login.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.18.0",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-sql": "^6.7.0",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/view": "^6.34.0",
    "@finos/perspective": "^3.8.0",
    "@finos/perspective-viewer": "^3.8.0",
    "@finos/perspective-viewer-datagrid": "^3.8.0",
    "@fontsource/space-grotesk": "^5.2.10",
    "@reduxjs/toolkit": "^2.2.0",
    "@uiw/react-codemirror": "^4.23.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-redux": "^9.1.2",
    "react-router-dom": "^6.30.4",
    "reactflow": "^11.11.4"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "c8": "^12.0.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fernandomarcius/cflow.git",
    "directory": "web"
  }
}
