# Copy to .env and adjust. NEVER commit real secrets - .env is in .gitignore.
# Every application setting is an environment variable with the CFLOW_ prefix
# (see core/src/cflow_core/config.py for the authoritative list and defaults).

# --- PostgreSQL (container) ---------------------------------------------------------------------
# The container superuser is the schema owner role (cflow_owner).
POSTGRES_DB=cflow
POSTGRES_USER=cflow_owner
POSTGRES_PASSWORD=change-me-owner
# Host port published by the container (change it if 5432 is taken).
POSTGRES_HOST_PORT=5433

# Runtime role of the application (created by migration 0002). API and worker connect ONLY as cflow_app.
CFLOW_APP_USER=cflow_app
CFLOW_APP_PASSWORD=change-me-app

# URLs for tooling on the HOST (make migrate, make test) - point at localhost:POSTGRES_HOST_PORT.
# The api/worker containers do NOT use these: docker-compose injects a URL with host "postgres".
# Runtime/tests (cflow_app):
CFLOW_DATABASE_URL=postgresql+asyncpg://cflow_app:change-me-app@localhost:5433/cflow
# Alembic migrations (cflow_owner):
CFLOW_OWNER_DATABASE_URL=postgresql+asyncpg://cflow_owner:change-me-owner@localhost:5433/cflow

# --- Temporal -----------------------------------------------------------------------------------
# Execution = workflow, each node = activity. `make up` starts it with --profile temporal.
CFLOW_TEMPORAL_HOST=temporal:7233
# true (default): execution through Temporal; false: inline (synchronous, no worker).
CFLOW_USAR_TEMPORAL=true

# Temporal persistence: dedicated role and databases in the same Postgres. The role is created when
# the Postgres volume is first initialised (deploy/postgres/init-temporal-role.sh).
TEMPORAL_DB_USER=temporal_app
TEMPORAL_DB_PASSWORD=change-me-temporal
TEMPORAL_DB_NAME=temporal
TEMPORAL_VISIBILITY_DB_NAME=temporal_visibility
# Workflow history retention.
TEMPORAL_RETENCAO=720h

# --- Application --------------------------------------------------------------------------------
CFLOW_TZ=UTC
CFLOW_LOG_LEVEL=INFO

# --- Authentication -----------------------------------------------------------------------------
# Admin bootstrap - read by migration 0003 (the plain password is never persisted, only its hash).
CFLOW_ADMIN_EMAIL=admin@example.com
CFLOW_ADMIN_PASSWORD=change-me-admin-long-password
# Session / recovery / brute-force limits (seconds, except counts).
# Inactivity 8 h: the Studio works client-side for long stretches without hitting the API.
CFLOW_SESSAO_INATIVIDADE_SEGUNDOS=28800
CFLOW_SESSAO_ABSOLUTA_SEGUNDOS=86400
CFLOW_RECUPERACAO_EXPIRA_SEGUNDOS=1800
CFLOW_FORCA_BRUTA_MAX=5
CFLOW_FORCA_BRUTA_JANELA_SEGUNDOS=900
CFLOW_SENHA_MIN=12
# Recovery channel: without SMTP configured, falls back to the console log (air-gapped).
# CFLOW_SMTP_HOST=smtp.example.com
# CFLOW_SMTP_PORTA=25
# CFLOW_SMTP_REMETENTE=no-reply@example.com
# CFLOW_SMTP_TLS=false
# CFLOW_SMTP_USER=
# CFLOW_SMTP_PASSWORD=
# Public URL of the web UI (link in e-mails); without it only the token is sent.
# CFLOW_APP_URL=http://localhost:5173
# SSO / OIDC (disabled when the issuer is empty)
# CFLOW_OIDC_ISSUER=
# CFLOW_OIDC_CLIENT_ID=
# CFLOW_OIDC_JWKS_URI=
# CFLOW_OIDC_PERFIL_PADRAO=operador

# --- Credential vault ---------------------------------------------------------------------------
# Fernet key (urlsafe base64, 32 bytes). Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CFLOW_VAULT_KEY=change-me-with-a-valid-fernet-key
CFLOW_CONEXAO_TESTE_TIMEOUT_SEGUNDOS=5
CFLOW_CONEXAO_AMOSTRA_TIMEOUT_SEGUNDOS=30

# --- Source connection pool (worker) --------------------------------------------------------------
# Reuses live database connections between runs of the fan-out (saves the re-login). Only execution
# reads use the pool; preview/test use a fresh connection.
CFLOW_POOL_FONTES=true
CFLOW_POOL_FONTES_TTL_SEGUNDOS=60
CFLOW_POOL_FONTES_MAX=4

# --- External ingestion / lake ------------------------------------------------------------------
# Dedicated Temporal queue: a ten-year backfill must not compete with pipeline runs.
CFLOW_INGESTAO_TASK_QUEUE=cflow-ingestao
# Root of the lake on the LOCAL backend (default, air-gapped). To write to GCS register a connection
# of type `objeto` (provider=gcs) with the service-account JSON IN THE VAULT and point the source at
# it: the credential never comes through an environment variable.
CFLOW_LAKE_DIR=lake
# Development: the lake is ALWAYS local. With `true`, a lake connection pointing at GCS is refused
# before any read or write, so a dev run can never publish to production buckets. Leave unset (or
# false) in an environment that really uses a bucket.
CFLOW_LAKE_SOMENTE_LOCAL=true
CFLOW_INGESTAO_HTTP_TIMEOUT_SEGUNDOS=180
# Byte ceiling of one download (the payload is read whole to hash it before writing).
CFLOW_INGESTAO_DOWNLOAD_MAX_MB=512
# Durability of writes to the remote lake: per-request retry, composing with Temporal's retry.
CFLOW_LAKE_MAX_TENTATIVAS=4
CFLOW_LAKE_BACKOFF_TETO_SEGUNDOS=20
# Check md5 on upload and on read (x-goog-hash).
CFLOW_LAKE_VERIFICAR_CHECKSUM=true
# Corruption hunting only: re-download even with the local cache present.
CFLOW_LAKE_VERIFICAR_CACHE=false

# --- Scalable worker - all optional ---------------------------------------------------------------
# Simultaneous activities per worker process (= executor threads). Size by container cores.
# CFLOW_WORKER_MAX_ATIVIDADES=8
# DuckDB budget PER CONNECTION. Unset: derived from the container cgroup (memory.max / cpu.max)
# divided by CFLOW_WORKER_MAX_ATIVIDADES; with no cgroup limit DuckDB defaults to 80% of the host RAM
# per connection.
# CFLOW_DUCKDB_MEMORY_LIMIT=2GB
# CFLOW_DUCKDB_THREADS=2
# CFLOW_DUCKDB_TEMP_DIR=/tmp/duckdb
# SQLAlchemy pool per event loop. With N worker replicas: N x (pool + overflow) + api must fit in
# Postgres `max_connections` (beyond that, use a pooler).
# CFLOW_DB_POOL_SIZE=20
# CFLOW_DB_MAX_OVERFLOW=10
# CFLOW_DB_ATRAS_DE_PGBOUNCER=false   # true disables the asyncpg prepared-statement cache
# Prometheus metrics of the Temporal SDK in the worker. Unset: disabled.
# CFLOW_METRICAS_PORTA=9464
# Periodic loops (scheduler, ingestion, reaper) in this process. false on an activities-only deployment.
# CFLOW_WORKER_TICKS=true

# --- Other optional settings (defaults in core/src/cflow_core/config.py) -------------------------
# CFLOW_TEMPORAL_TASK_QUEUE=cflow-execucao
# CFLOW_RELATORIOS_TASK_QUEUE=cflow-relatorios
# CFLOW_RELATORIOS_CONCORRENCIA=4
# CFLOW_PRIMEIRA_SENHA_EXPIRA_SEGUNDOS=259200
# CFLOW_CONEXAO_QUERY_TIMEOUT_SEGUNDOS=600
# CFLOW_GATEWAY_MAX_CONCORRENCIA=4
# CFLOW_GATEWAY_TOKEN_TTL_SEGUNDOS=240
# CFLOW_GATEWAY_MAX_TENTATIVAS=4
# CFLOW_HTTP_NO_TIMEOUT_SEGUNDOS=30
# CFLOW_HTTP_NO_CONCORRENCIA_MAX=16
# CFLOW_PREVIEW_SESSAO_TTL_SEGUNDOS=900
# CFLOW_PREVIEW_SESSAO_MAX=50
# CFLOW_SNAPSHOT_DIR=snapshots
# CFLOW_EXPORT_DIR=export
# CFLOW_UPLOAD_DIR=/app/uploads
# CFLOW_LAKE_CACHE_DIR=lake_cache
# CFLOW_LAKE_PREVIEW_FATIAS=1
# CFLOW_SANDBOX_TIMEOUT_SEGUNDOS=600
# CFLOW_SANDBOX_MEMORIA_MB=2048
# CFLOW_SANDBOX_SAIDA_MAX_MB=4096
# TLS to the metadata Postgres and secrets mounted as files:
# CFLOW_DATABASE_TLS=false
# CFLOW_DATABASE_CA_FILE=
# CFLOW_DATABASE_SCHEMA=
# CFLOW_SECRETS_DIR=/run/secrets/cflow
# PII tokenisation (full name of the KMS HMAC key VERSION; empty disables it and makes publishing
# of PII be REFUSED):
# CFLOW_PII_CHAVE_KMS=

# --- Read by scripts / compose (outside config.py) -----------------------------------------------
# CFLOW_BACKUP_KEEP=7                 # scripts/backup.py: dumps kept
# CFLOW_PG_CONTAINER=cflow-postgres-1 # scripts/backup.py: Postgres container name
# CFLOW_TEMPORAL_HOST_TESTE=localhost:7233   # integration test harness
# CFLOW_IMAGE_TAG=latest              # docker-compose image tag
# WEB_HOST_PORT=5173                  # docker-compose: web port on the host
# TEMPORAL_UI_PORT=8233               # docker-compose: Temporal UI port on the host
